generator client {
  provider = "prisma-client-js"
    output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BlogStatus {
  DRAFT
    PUBLISHED
    REMOVED
    ARCHIVED
}


enum SeatType {
  REGULAR
    REGULAR_WHEELCHAIR_ACCESSIBLE
}
enum PaymentStatus {
  REQUIRES_PAYMENT_METHOD
    REQUIRES_CONFIRMATION
    REQUIRES_ACTION
    PROCESSING
    REQUIRES_CAPTURE
    SUCCEEDED
    REFUND_PENDING
    REFUNDED
    DISPUTED
    FAILED 
}

enum BookingStatus {
  INITIATED
    BOOKED
    EXPIRED
    CANCELLED
}

enum PaymentMethod {
  CASH
    CARD
}
model payment {
  id                    Int           @id @default(autoincrement())
    provider              PaymentMethod @default(CARD)
    status                PaymentStatus
    amountCents           Int
    currency              String
    userId                Int?
    bookingId             Int?          @unique
    invoiceId             Int?
    stripePaymentIntentId String        @unique
    stripeChargeId        String?       @unique
    stripeCustomerId      String?
    stripeEventLastId     String?
    livemode              Boolean       @default(false)
    receiptEmail          String?
    description           String?
    metadata              Json?
    paidAt                DateTime?
    createdAt             DateTime      @default(now())
    updatedAt             DateTime      @updatedAt
    booking               booking?      @relation(fields: [bookingId], references: [id])
    invoice               invoice?      @relation(fields: [invoiceId], references: [id])
    user                  user?         @relation(fields: [userId], references: [id])
    stripeEvents          stripeEvent[]

    @@index([userId])
    @@index([status])
    @@index([stripeCustomerId])
}

model stripeEvent {
  id                    Int       @id @default(autoincrement())
    stripeEventId         String    @unique
    type                  String
    livemode              Boolean   @default(false)
    created               Int?
    processedAt           DateTime?
    payload               Json?
    stripePaymentIntentId String?
    paymentId             Int?
    createdAt             DateTime  @default(now())
    payment               payment?  @relation(fields: [paymentId], references: [id])

    @@index([type])
    @@index([processedAt])
    @@index([stripePaymentIntentId])
    @@index([paymentId])
}

model blog {
  id            Int        @id @default(autoincrement())
    title         String
    slug          String     @unique
    author        String
    publishedDate DateTime?
    createdAt     DateTime   @default(now())
    updatedAt     DateTime   @updatedAt
    content       String
    featuredMedia String?
    status        BlogStatus @default(DRAFT)
}

model service {
  id         Int      @id @default(autoincrement())
  heading    String
  subheading String
  href       String
  mediaUrl   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model cinema {
  id        Int          @id @default(autoincrement())
    name      String
    location  String?
    auditoria auditorium[]
    events    event[]
}

model event {
  id           Int            @id @default(autoincrement())
    title        String
    cinemaId     Int
    cinema       cinema         @relation(fields: [cinemaId], references: [id])
    date         DateTime
    startTime    String
    endTime      String
    category     String
    status       String
    capacity     Int?
    priceCents   Int?
    thumbnailUrl String?
    description  String?
    bookings     eventBooking[]
    createdAt    DateTime       @default(now())
    updatedAt    DateTime       @updatedAt

    @@index([cinemaId])
}

model auditorium {
  id       Int    @id @default(autoincrement())
    name     String
    cinemaId Int
    cinema   cinema @relation(fields: [cinemaId], references: [id])
    seats    seat[]
    shows    show[]
}

model seat {
  id           Int           @id @default(autoincrement())
    row          String
    number       String
    auditoriumId Int
    seatType     SeatType
    columnOffset Int
    rowOffset    Int
    bookingSeats bookingSeat[]
    auditorium   auditorium    @relation(fields: [auditoriumId], references: [id])
}

model movie {
  id          Int      @id @default(autoincrement())
    title       String
    description String
    durationMin Int
    language    String
    releaseDate DateTime
    posterUrl   String?
    trailerUrl  String?
    genres      String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    casts       String?
    rating      String?
    slug        String?  @unique
    director    String?
    banners     banner[]
    shows       show[]
}

model show {
  id           Int         @id @default(autoincrement())
    startAt      DateTime
    auditoriumId Int
    movieId      Int?
    bookings     booking[]
    seatPrices   seatPrice[]
    auditorium   auditorium  @relation(fields: [auditoriumId], references: [id])
    movie        movie?      @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model user {
  id                         Int        @id @default(autoincrement())
    email                      String?    @unique
    firstName                  String
    lastName                   String
    passwordHash               String?
    createdAt                  DateTime   @default(now())
    emailVerificationExpiresAt DateTime?
    emailVerificationTokenHash String?
    emailVerifiedAt            DateTime?
    passwordResetExpiresAt     DateTime?
    passwordResetTokenHash     String?
    accounts                   account[]
    bookings                   booking[]
    eventBookings              eventBooking[]
    payments                   payment[]
    userRoles                  userRole[]
    sessions     Session[]
}

model account {
  id                Int    @id @default(autoincrement())
    userId            Int
    provider          String
    providerAccountId String
    user              user   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model role {
  id        Int        @id @default(autoincrement())
    name      String     @unique
    createdAt DateTime   @default(now())
    isSystem  Boolean    @default(false)
    userRoles userRole[]
}

model userRole {
  userId Int
    roleId Int
    role   role @relation(fields: [roleId], references: [id])
    user   user @relation(fields: [userId], references: [id])

    @@unique([userId, roleId])
}

model booking {
  id                      Int           @id @default(autoincrement())
    showId                  Int
    reservedAt              DateTime?
    priceCents              Int
    userId                  Int?
    createdAt               DateTime      @default(now())
    expiresAt               DateTime
    invoiceId               Int?
    status                  BookingStatus
    paymentId               Int?
    stripeCheckoutSessionId String?       @unique
    invoice                 invoice?      @relation(fields: [invoiceId], references: [id])
    show                    show          @relation(fields: [showId], references: [id])
    user                    user?         @relation(fields: [userId], references: [id])
    bookingSeats            bookingSeat[]
    payment                 payment?
}

model eventBooking {
  id                      Int           @id @default(autoincrement())
    eventId                 Int
    event                   event         @relation(fields: [eventId], references: [id])
    userId                  Int?
    user                    user?         @relation(fields: [userId], references: [id])
    status                  BookingStatus
    quantity                Int
    priceCents              Int
    stripeCheckoutSessionId String?       @unique
    reservedAt              DateTime?
    createdAt               DateTime      @default(now())
    updatedAt               DateTime      @updatedAt

    @@index([eventId])
}

model invoice {
  id            Int           @id @default(autoincrement())
    priceCents    Int
    paymentMethod PaymentMethod
    userName      String
    detailJson    String
    remarks       String
    bookings      booking[]
    payments      payment[]
}

model bookingSeat {
  id        Int     @id @default(autoincrement())
    bookingId Int
    seatId    Int?
    booking   booking @relation(fields: [bookingId], references: [id])
    seat      seat?   @relation(fields: [seatId], references: [id])
}

model banner {
  id          Int    @id @default(autoincrement())
    movieId     Int?
    tag         String
    title       String
    description String
    buttonText  String
    link        String
    movie       movie? @relation(fields: [movieId], references: [id])
}

model seatPrice {
  id         Int      @id @default(autoincrement())
    showId     Int
    seatType   SeatType
    priceCents Int
    show       show     @relation(fields: [showId], references: [id])

    @@unique([showId, seatType])
}









model Session {
  id               String   @id @default(cuid())
    sid              String   @unique
    userId           Int
    refreshTokenHash String
    revoked          Boolean  @default(false)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    user user @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}
